# Terraform working directory (providers/modules cache)
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config files (local)
.terraformrc
terraform.rc

# Temporary vars file generated by scripts/tf-env.sh
.tfenv.auto.tfvars
